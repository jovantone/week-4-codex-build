    "check": "astro check"
  },
  "dependencies": {
    "@astrojs/node": "^9.4.0", "astro": "^5.13.0", "drizzle-orm": "^0.44.5",
    "pg": "^8.16.3", "nanoid": "^5.1.5", "alpinejs": "^3.14.9",
    "htmx.org": "^2.0.7", "htmx-ext-sse": "^2.2.3", "tailwindcss": "^4.1.13", "@tailwindcss/vite": "^4.1.13"
  },
  "devDependencies": { "@astrojs/check": "^0.9.4", "typescript": "^5.9.2", "@types/node": "^24.0.0" },
  "engines": { "node": ">=24" }
